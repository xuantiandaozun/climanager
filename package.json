{
  "name": "climanager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "icons:generate": "powershell -ExecutionPolicy Bypass -File scripts/msix/generate-assets.ps1",
    "msix:stage": "powershell -ExecutionPolicy Bypass -File scripts/msix/stage.ps1",
    "msix:pack": "powershell -ExecutionPolicy Bypass -File scripts/msix/pack.ps1",
    "msix:sign-dev": "powershell -ExecutionPolicy Bypass -File scripts/msix/sign-dev.ps1",
    "msix:build": "pnpm msix:stage && pnpm msix:pack"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "vue": "^3.5.24",
    "vue-i18n": "^11.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.3"
  }
}
